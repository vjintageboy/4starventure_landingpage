{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/AovChart/**",
              "components/general/ConversionChart/**",
              "components/general/DateRangePicker/**",
              "components/general/EmptyState/**",
              "components/general/IconAddressAlert/**",
              "components/general/IconSpinner/**",
              "components/general/InlineDateRangeCalendar/**",
              "components/general/MetricStrip/**",
              "components/general/PageHeader/**",
              "components/general/ProductBarChart/**",
              "components/general/RevenueChart/**",
              "components/general/Skeleton/**",
              "components/general/StatusBadge/**",
              "components/general/StoreBarChart/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sohne))/i]",
        "message": "Font not provided by the design system. Available: Sohne."
      },
      {
        "selector": "JSXOpeningElement[name.name='AovChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:buckets|currency|mixedCurrency|key|ref|className|style|children)$/]",
        "message": "<AovChart> doesn't accept that prop. Declared props: buckets, currency, mixedCurrency."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConversionChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:buckets|key|ref|className|style|children)$/]",
        "message": "<ConversionChart> doesn't accept that prop. Declared props: buckets."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateRangePicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|to|onSelect|placeholder|key|ref|className|style|children)$/]",
        "message": "<DateRangePicker> doesn't accept that prop. Declared props: from, to, onSelect, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, description, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineDateRangeCalendar'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|to|onSelect|key|ref|className|style|children)$/]",
        "message": "<InlineDateRangeCalendar> doesn't accept that prop. Declared props: from, to, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|detail|key|ref|className|style|children)$/]",
        "message": "<MetricStrip> doesn't accept that prop. Declared props: lead, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|badges|actions|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, description, badges, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductBarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|data|currency|mixedCurrency|metric|key|ref|className|style|children)$/]",
        "message": "<ProductBarChart> doesn't accept that prop. Declared props: title, data, currency, mixedCurrency, metric."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductBarChart'] > JSXAttribute[name.name='metric'] > Literal[value!=/^(?:revenue|units|orders)$/]",
        "message": "<ProductBarChart> metric must be one of 'revenue' | 'units' | 'orders'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevenueChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:buckets|currency|mixedCurrency|granularityLabel|key|ref|className|style|children)$/]",
        "message": "<RevenueChart> doesn't accept that prop. Declared props: buckets, currency, mixedCurrency, granularityLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:success|warning|danger|info|neutral)$/]",
        "message": "<StatusBadge> variant must be one of 'success' | 'warning' | 'danger' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreBarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|currency|mixedCurrency|key|ref|className|style|children)$/]",
        "message": "<StoreBarChart> doesn't accept that prop. Declared props: data, currency, mixedCurrency."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
